#!/bin/sh
# commit-msg hook - drop Co-authored-by trailers that credit an AI tool, so
# commits stay authored by the user. Human co-authors are kept. Then require
# a Conventional Commits subject and no "Generated with" lines.

# AI-tool co-author addresses, as regex alternatives.
ai='cursoragent@cursor[.]com|noreply@anthropic[.]com'

tmp=$(mktemp "${1}.tmp.XXXXXX") || exit 1
trap 'rm -f "$tmp"' 0
trap 'exit 1' HUP INT TERM

awk -v ai="$ai" '
    tolower($0) ~ "^co-authored-by:.*<(" ai ")>" { next }
    /^$/ { blank++; next }                      # hold blank lines...
    { while (blank) { print ""; blank-- } print } # ...until text follows
' "$1" > "$tmp" && mv "$tmp" "$1"

subject=$(sed -n '1p' "$1")
case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'; then
    echo "BLOCKED by global commit-msg hook: subject is not a Conventional Commit: $subject" >&2
    echo "   Fix: <type>(<scope>): <summary>, e.g. 'fix(api): handle empty input'" >&2
    echo "   (HUMAN BYPASS ONLY: git commit --no-verify)" >&2
    exit 1
fi
if grep -qiE '^(🤖 )?generated (with|by) ' "$1"; then
    echo "BLOCKED by global commit-msg hook: remove the 'Generated with' line." >&2
    echo "   (HUMAN BYPASS ONLY: git commit --no-verify)" >&2
    exit 1
fi
