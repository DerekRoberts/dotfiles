#!/bin/sh
# commit-msg hook - drop Co-authored-by trailers that credit an AI tool, so
# commits stay authored by the user. Human co-authors are kept. Block
# "Generated with" attribution lines (Conventional Commits belong on PR titles,
# e.g. bcgov/actions/pr-validate, not on local commit subjects).

# AI-tool co-author addresses, as regex alternatives.
ai='cursoragent@cursor[.]com|noreply@anthropic[.]com'

tmp=$(mktemp "${1}.tmp.XXXXXX") || exit 1
trap 'rm -f "$tmp"' 0
trap 'exit 1' HUP INT TERM

awk -v ai="$ai" '
    tolower($0) ~ "^co-authored-by:.*<(" ai ")>" { next }
    /^$/ { blank++; next }                      # hold blank lines...
    { while (blank) { print ""; blank-- } print } # ...until text follows
' "$1" > "$tmp" && mv "$tmp" "$1"

if grep -qiE '^[[:space:]]*(🤖 )?generated (with|by) ' "$1"; then
    echo "BLOCKED by global commit-msg hook: remove the 'Generated with' line." >&2
    echo "   (HUMAN BYPASS ONLY: git commit --no-verify)" >&2
    exit 1
fi
