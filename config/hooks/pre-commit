#!/bin/bash
# Pre-commit hook - Global safety checks for AI agents and developers.
set -euo pipefail

# Git hooks often have a stripped PATH; CLI tools live in userspace on Kinoite.
export PATH="${HOME}/.local/bin:${PATH}"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks not found. Ensure gitleaks is installed on your PATH." >&2
  exit 1
fi

gitleaks protect --staged --redact --no-banner

# A version-downgrade check used to live here. It compared the first
# version-shaped number among the removed lines against the first among the
# added lines, which are unrelated values in any diff touching more than one
# line — so it blocked good commits and missed real downgrades. Reinstate only
# with a real per-key parse (jq for package.json, yq for workflows).

