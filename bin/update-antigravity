#!/bin/bash
# Script to safely update Google Antigravity and Antigravity IDE on Linux/Fedora
# Manages process termination, directory cleaning, direct extraction, and SELinux relabeling.

set -euo pipefail

DOWNLOADS_DIR="$HOME/Downloads"
TARGET_CORE="$HOME/.local/bin/antigravity"
TARGET_IDE="$HOME/.local/bin/antigravity-ide"

CORE_TARBALL="$DOWNLOADS_DIR/Antigravity.tar.gz"
IDE_TARBALL="$DOWNLOADS_DIR/Antigravity IDE.tar.gz"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== Antigravity Update Helper ===${NC}"

# Check if there is anything to update
if [[ ! -f "$CORE_TARBALL" && ! -f "$IDE_TARBALL" ]]; then
    echo -e "${RED}Error: No update tarballs found in $DOWNLOADS_DIR.${NC}"
    echo "Please download Antigravity.tar.gz and/or Antigravity IDE.tar.gz first."
    exit 1
fi

# Function to kill running instances safely
kill_antigravity_processes() {
    echo "Terminating running Antigravity processes to prevent file locks..."
    pkill -9 -f headroom 2>/dev/null || true
    pkill -9 -f antigravity 2>/dev/null || true
    echo "✓ Stopped background processes."
}

# Function to update Antigravity Core
update_core() {
    echo -e "${BLUE}Updating Antigravity Core...${NC}"
    mkdir -p "$TARGET_CORE"
    
    echo "Cleaning target directory: $TARGET_CORE"
    rm -rf "${TARGET_CORE:?}"/*
    
    echo "Extracting $CORE_TARBALL..."
    tar -xzf "$CORE_TARBALL" -C "$TARGET_CORE" --strip-components=1
    echo "✓ Extracted Core files."
}

# Function to update Antigravity IDE
update_ide() {
    echo -e "${BLUE}Updating Antigravity IDE...${NC}"
    mkdir -p "$TARGET_IDE"
    
    echo "Cleaning target directory: $TARGET_IDE"
    rm -rf "${TARGET_IDE:?}"/*
    
    echo "Extracting $IDE_TARBALL..."
    tar -xzf "$IDE_TARBALL" -C "$TARGET_IDE" --strip-components=1
    echo "✓ Extracted IDE files."
}

# Function to apply SELinux labeling
apply_selinux_contexts() {
    if command -v restorecon >/dev/null 2>&1; then
        echo -e "${BLUE}Restoring SELinux security contexts...${NC}"
        restorecon -R -v "$TARGET_CORE" "$TARGET_IDE"
        echo "✓ SELinux labeling completed successfully."
    else
        echo -e "${BLUE}SELinux restorecon utility not found. Skipping context labeling.${NC}"
    fi
}

# Run the update steps
kill_antigravity_processes

if [[ -f "$CORE_TARBALL" ]]; then
    update_core
fi

if [[ -f "$IDE_TARBALL" ]]; then
    update_ide
fi

apply_selinux_contexts

echo -e "${GREEN}✅ Update completed successfully!${NC}"
echo "You can now launch the IDE or CLI."
