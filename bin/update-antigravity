#!/bin/bash
# Script to safely update Google Antigravity and Antigravity IDE on Linux/Fedora
set -euo pipefail

DOWNLOADS_DIR="$HOME/Downloads"
TARGET_CORE="$HOME/.local/bin/antigravity"
TARGET_IDE="$HOME/.local/bin/antigravity-ide"

CORE_TARBALL="$DOWNLOADS_DIR/Antigravity.tar.gz"
IDE_TARBALL="$DOWNLOADS_DIR/Antigravity IDE.tar.gz"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}=== Antigravity Update Helper ===${NC}"

# Check if there is anything to update
if [[ ! -f "$CORE_TARBALL" && ! -f "$IDE_TARBALL" ]]; then
    echo -e "${RED}Error: No update tarballs found in $DOWNLOADS_DIR.${NC}"
    echo "Please download Antigravity.tar.gz and/or Antigravity IDE.tar.gz first."
    exit 1
fi

echo "Terminating running Antigravity processes to prevent file locks..."
pkill -9 -f headroom 2>/dev/null || true
pkill -9 -f antigravity 2>/dev/null || true
echo "✓ Stopped background processes."

update_app() {
    local name="$1"
    local tarball="$2"
    local target="$3"

    if [[ -f "$tarball" ]]; then
        echo -e "${BLUE}Updating $name...${NC}"
        mkdir -p "$target"
        echo "Cleaning target directory: $target"
        rm -rf "${target:?}"/*
        echo "Extracting $tarball..."
        tar -xzf "$tarball" -C "$target" --strip-components=1
        echo "✓ Extracted $name files."
    fi
}

update_app "Antigravity Core" "$CORE_TARBALL" "$TARGET_CORE"
update_app "Antigravity IDE" "$IDE_TARBALL" "$TARGET_IDE"

if command -v restorecon >/dev/null 2>&1; then
    echo -e "${BLUE}Restoring SELinux security contexts...${NC}"
    restorecon -R -v "$TARGET_CORE" "$TARGET_IDE"
    echo "✓ SELinux labeling completed successfully."
fi

echo -e "${GREEN}✅ Update completed successfully!${NC}"
echo "You can now launch the IDE or CLI."
